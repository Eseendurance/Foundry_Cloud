# Neon PostgreSQL is the application database.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR_DATABASE?sslmode=require

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional local/private-network Ollama-compatible endpoint. No hosted AI
# provider is contacted. Leave unset to keep generation endpoints offline.
LOCAL_LLM_URL=http://llm:11434/api/chat
LOCAL_LLM_MODEL=

# Direct SMTP server owned by this deployment. Leave blank until configured.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_HELO_HOST=mail.example.com
SMTP_PUBLIC_IP=
SMTP_WARMUP_DAILY_LIMIT=50
DKIM_SELECTOR=
DKIM_PUBLIC_KEY=

# Optional payment adapters. Paystack calls are made only when a checkout,
# verification, or refund is explicitly requested.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=

# Use a persistent mounted directory for self-hosted deployments.
FOUNDRY_STORAGE_DIR=/var/lib/foundry/storage

SITE_DOMAIN=example.com

SITE_URL=https://example.com
