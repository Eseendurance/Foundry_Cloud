# ── AI providers (app builder, IDE agent, full-stack generator) ──
# You need at least ONE of these three. If you set more than one,
# the app tries them in this order and falls back automatically —
# so a rejected card or an expired key on one doesn't take the
# feature down as long as another is configured.

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Accounts + workspace database + search ──
# Any standard Postgres connection string. Neon, Supabase, Vercel
# Postgres, and Railway all issue one in this format. Tables are
# created automatically on first use — no migration step needed.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random secret used to sign session cookies AND to encrypt your
# GitHub access token at rest. Generate with: openssl rand -base64 32
JWT_SECRET=

# ── Email (send + real open/click tracking) ──
# Any real SMTP account: AWS SES, Postmark, SendGrid, Mailgun, or a
# personal account for testing. The SPF/DMARC checker on the same
# page needs none of this — it's live DNS, no account required.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Your Product <you@yourdomain.com>"

# ── AI voice ──
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# ── GitHub integration (Connect to GitHub, push from the IDE) ──
# Create a free OAuth App at https://github.com/settings/developers
# Homepage URL: your Vercel URL
# Authorization callback URL: https://<your-app>.vercel.app/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Site URL ──
# Used for the sitemap, robots.txt, Open Graph tags, and to build
# correct email tracking links. Set this to your real deployed URL.
SITE_URL=
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/foundry_db?schema=public"

# ── Not configured via env vars ──
# Domain lookup (/domains) needs nothing — live RDAP + DNS, no key.
# Developer API keys (/settings/developer) are generated in-app and
# stored hashed in your own database — nothing to set here either.
