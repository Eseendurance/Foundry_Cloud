# The only hosted data service supported by this deployment.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR_DATABASE?sslmode=require

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional local/private-network Ollama-compatible endpoint. No hosted AI
# provider is contacted. Leave unset to keep generation endpoints offline.
LOCAL_LLM_URL=http://llm:11434/api/chat
LOCAL_LLM_MODEL=

# Direct SMTP server owned by this deployment.
SMTP_HOST=mail.example.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Foundry-Cloud <noreply@example.com>"
SMTP_HELO_HOST=mail.example.com
SMTP_PUBLIC_IP=
DKIM_SELECTOR=
DKIM_PUBLIC_KEY=

# Use a persistent mounted directory for self-hosted deployments.
FOUNDRY_STORAGE_DIR=/var/lib/foundry/storage

SITE_DOMAIN=example.com

SITE_URL=https://example.com
